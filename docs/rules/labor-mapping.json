      "mappingVersion": "R30@2026-11-12.1",
      "kind": "O",
      "source": "《劳动合同法》第三十条",
      "bearer": "用人单位",
      "action": "及时足额支付劳动报酬",
      "actionAtom": "act_R30",
      "condition": {
        "fact": "employment_exists",
        "eq": true
