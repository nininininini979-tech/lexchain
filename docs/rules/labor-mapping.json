    {
      "id": "R82",
      "mappingVersion": "R82@2026-11-12.1",
      "kind": "O",
      "source": "《劳动合同法》第八十二条第一款",
      "bearer": "用人单位",
      "action": "每月支付二倍工资（差额）",
