      "exceptions": [],
      "fulfillment": {
        "fact": "wage_paid_on_time_full",
        "eq": true
      },
      "violationOf": null,
      "limits": [
        "沿用原受控事实词表，尚未完成完整法律要件、地域口径及当前司法解释审核。",
        "按时足额支付是历史履行观察，与规范要求的行为命题分离。"
      ],
      "factKeys": [
        "employment_exists",
        "wage_paid_on_time_full"
      ],
      "formula": "O(act_R30 | A_R30 & !E_R30)",
      "conditionAtom": "A_R30",
      "exceptionAtom": "E_R30"
    },
    {
