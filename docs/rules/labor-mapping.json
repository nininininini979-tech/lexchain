        ]
      },
      "exceptions": [],
      "fulfillment": {
        "fact": "double_wage_paid",
        "eq": true
      },
      "violationOf": null,
      "limits": [
        "原拒签例外过宽：实施条例第五条与第六条期间及责任不同；本版本停用该旧例外，提交人工审核。"
      ],
      "quarantinedExceptions": [
        {
          "id": "X82-1",
          "source": "《劳动合同法实施条例》第五条、第六条",
